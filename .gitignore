!/stonecutter-shared-files.properties
!/gradle/
!/src/
!/versions/

# Generated output within the included source/build trees.
**/.gradle/
**/build/
**/bin/
**/run/
**/run-client/
**/run-client-fabric/
**/run-server/
**/run-data/
**/.cache/
*.class
*.jar
!gradle-wrapper.jar
*.log
*.log.gz
*.tmp
*.bak
*.backup
__pycache__/
*.pyc
.env
.env.*
