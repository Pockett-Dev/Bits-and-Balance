{
  "schemaVersion": 1,
  "id": "${mod_id}",
  "version": "${mod_version}",
  "name": "${mod_name}",
  "description": "${mod_description}",
  "authors": [
    "${mod_authors}"
  ],
  "license": "${mod_license}",
  "icon": "logo.png",
  "environment": "*",
  "mixins": [
    "bitsandbalance.fabric.mixins.json"
  ],
  "entrypoints": {
    "main": [
      "org.onenonly.bitsandbalance.fabric.BitsAndBalanceFabric"
    ],
    "client": [
      "org.onenonly.bitsandbalance.fabric.BitsAndBalanceFabricClient"
    ],
    "jade": [
      "org.onenonly.bitsandbalance.common.compat.jade.BitsAndBalanceJadePlugin"
    ],
    "jei_mod_plugin": [
      "org.onenonly.bitsandbalance.fabric.compat.jei.BitsAndBalanceJeiPlugin"
    ]
  },
  "depends": {
    "minecraft": "${minecraft_version}",
    "fabricloader": ">=${fabric_loader_version}",
    "fabric-api": ">=${fabric_api_version}"
  }
}
